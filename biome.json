{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "origin/dev"
  },
  "files": {
    "includes": [
      "**",
      "!tests/fixtures",
      "!research",
      "!archive",
      "!design",
      "!.claude",
      "!.agents",
      "!**/dist",
      "!**/out",
      "!package-lock.json",
      "!src/harness-seed/types/host-api.d.ts",
      "!evals/ledger",
      "!marketplace/template/scripts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["src/**", "scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } },
            "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 80, "skipBlankLines": true } },
            "noUselessTernary": "error"
          },
          "style": {
            "noNestedTernary": "error",
            "noParameterAssign": "error",
            "noUselessElse": "error",
            "useCollapsedIf": "error"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAriaHiddenOnFocusable": "warn",
        "noAutofocus": "warn",
        "noLabelWithoutControl": "warn",
        "noNoninteractiveTabindex": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useButtonType": "warn",
        "useFocusableInteractive": "warn",
        "useHtmlLang": "warn",
        "useKeyWithClickEvents": "warn",
        "useMediaCaption": "warn",
        "useSemanticElements": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "warn", "options": { "maxAllowedComplexity": 15 } },
        "noExcessiveLinesPerFunction": { "level": "warn", "options": { "maxLines": 80, "skipBlankLines": true } },
        "noUselessTernary": "warn"
      },
      "style": {
        "noEnum": "error",
        "noNestedTernary": "warn",
        "noNonNullAssertion": "warn",
        "noParameterAssign": "warn",
        "noUselessElse": "warn",
        "useCollapsedIf": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "warn",
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "warn",
        "noNonNullAssertedOptionalChain": "warn",
        "noShadowRestrictedNames": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  }
}

{
  "about": "Every genex-multiplayer Event variant in its bridge JSON shape (the serde shape the web bridge's drainEventsJson returns), mapped in order by one RelayMap at cut tick 100. expect is the RelayEffect's Debug text.",
  "cut_tick": 100,
  "tickets": { "r1": 7, "r2": 8, "r3": 9 },
  "rows": [
    { "event": { "type": "joined", "sessionId": "s1" }, "expect": "Seat { status: Joined, event: None }" },
    { "event": { "type": "playerJoined", "id": "s2" }, "expect": "Event(Joined { player: PlayerId(\"s2\") })" },
    { "event": { "type": "playerLeft", "id": "s2" }, "expect": "Event(Left { player: PlayerId(\"s2\") })" },
    { "event": { "type": "hostChanged", "host": "s2" }, "expect": "Event(Host { player: Some(PlayerId(\"s2\")) })" },
    { "event": { "type": "hostChanged", "host": null }, "expect": "Event(Host { player: None })" },
    { "event": { "type": "sharedChanged", "key": "score" }, "expect": "Event(Shared { key: \"score\" })" },
    { "event": { "type": "objectChanged", "id": "ball", "owner": "s2" }, "expect": "Event(Owner { object: \"ball\", owner: Some(PlayerId(\"s2\")) })" },
    { "event": { "type": "objectRemoved", "id": "ball" }, "expect": "Quiet(ObjectRemoved)" },
    { "event": { "type": "controlResult", "requestId": "r1", "operation": "claim", "id": "ball", "accepted": true, "owner": "s1", "sequence": 2, "reason": "accepted" }, "expect": "Event(Control { ticket: NetTicket(7), result: Accepted, retry_at_tick: None })" },
    { "event": { "type": "controlResult", "requestId": "r2", "operation": "claim", "id": "ball", "accepted": false, "reason": "held", "retryAfterMs": 500 }, "expect": "Event(Control { ticket: NetTicket(8), result: Held, retry_at_tick: Some(130) })" },
    { "event": { "type": "controlResult", "requestId": "r3", "operation": "release", "id": "ball", "accepted": false, "reason": "timeout" }, "expect": "Event(Control { ticket: NetTicket(9), result: Offline, retry_at_tick: None })" },
    { "event": { "type": "controlResult", "requestId": "r1", "operation": "claim", "id": "ball", "accepted": true, "reason": "accepted" }, "expect": "Quiet(UnknownRequest)" },
    { "event": { "type": "message", "kind": "boom", "data": { "a": 1 } }, "expect": "Event(Message { from: PlayerId(\"\"), kind: \"boom\", payload: Object {\"a\": Number(1)} })" },
    { "event": { "type": "input", "from": "s2", "data": { "jump": true } }, "expect": "Event(HostInput { from: PlayerId(\"s2\"), payload: Object {\"jump\": Bool(true)} })" },
    { "event": { "type": "roomOpen", "open": false }, "expect": "Event(RoomOpen { open: false })" },
    { "event": { "type": "chat", "id": 1, "from": "s2", "name": "Bo", "text": "gg", "at": 5 }, "expect": "Event(Chat { from: PlayerId(\"s2\"), name: \"Bo\", text: \"gg\" })" },
    { "event": { "type": "rateDrop", "dropped": 3 }, "expect": "Event(Warning { code: RateLimited })" },
    { "event": { "type": "serverRestart" }, "expect": "Quiet(ServerRestart)" },
    { "event": { "type": "matchStart", "roundId": 1 }, "expect": "Event(Match { status: Playing })" },
    { "event": { "type": "matchEnded", "data": {} }, "expect": "Event(Match { status: Ended })" },
    { "event": { "type": "matchRequeue", "reason": null }, "expect": "Event(Match { status: Searching })" },
    { "event": { "type": "queue", "position": 2, "size": 5 }, "expect": "Queue { position: 2, size: 5 }" },
    { "event": { "type": "seated" }, "expect": "Seat { status: Connecting, event: None }" },
    { "event": { "type": "reconnecting", "code": 1006 }, "expect": "Seat { status: Reconnecting, event: Some(Reconnecting { attempt: 1 }) }" },
    { "event": { "type": "reconnecting", "code": 1006 }, "expect": "Seat { status: Reconnecting, event: Some(Reconnecting { attempt: 2 }) }" },
    { "event": { "type": "reconnected" }, "expect": "Seat { status: Joined, event: Some(Reconnected) }" },
    { "event": { "type": "warning", "message": "found no relay socket" }, "expect": "Quiet(Warning)" },
    { "event": { "type": "disconnected", "code": 4409, "reason": "superseded" }, "expect": "Seat { status: Closed, event: Some(Closed { reason: Replaced }) }" },
    { "event": { "type": "joinFailed", "code": 426, "message": "protocol" }, "expect": "Seat { status: Closed, event: Some(Closed { reason: Other }) }" }
  ]
}

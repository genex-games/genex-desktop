{
  "apiVersion": 3,
  "id": "blender",
  "version": "1.2.0",
  "name": "Local Blender",
  "publisher": "Studio",
  "description": "Model 3D assets with Blender locally. No account or credits.",
  "icon": "icon.png",
  "backend": "backend.mjs",
  "capabilities": ["native-runtime", "project.read", "project.write", "jobs", "observe"],
  "tools": [
    {
      "name": "status",
      "description": "Inspect local Blender readiness and recorded jobs; no account or paid generation.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "model",
      "description": "Run a bpy script from assets/src in local Blender; export GLB and two renders. Optional format fbx also exports model.fbx for Unity, without an importer package. The script builds the scene and must not export or render. Returns exact asset paths and mesh/material stats. Integrate the model and verify visible use. To transform an existing GLB, pass model and import ASSET_INPUTS[\"model\"].",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "Optional project-relative GLB to transform. It is staged and available as ASSET_INPUTS[\"model\"]. Do not use absolute paths."
          },
          "format": {
            "type": "string",
            "description": "Optional glb (default) or fbx (also retains GLB and two renders). Choose fbx for native Unity projects."
          }
        },
        "required": ["name"]
      }
    },
    {
      "name": "retrieve",
      "description": "Retrieve an existing local Blender job without repeating it.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": ["id"]
      }
    }
  ],
  "skills": [
    {
      "name": "local-modeling",
      "text": "For useful 3D silhouettes, Local Blender can model assets from a bpy script at assets/src/<name>.py. Inspect blender__status first. The model script starts from an empty scene; do not save/export/render. Call blender__model, inspect returned renders, load the exact returned model.glb path with GLTFLoader and verify it in the actual game preview. Each export has a unique job directory. Preserve those paths in code; this is not the old assets/<slug>.glb layout. Reuse geometry and inspect triangle/texture costs. Size is a performance diagnostic, not a 4 MiB rejection. Native outputs including renders are capped at 100 MiB per job. For an existing GLB pass model to blender__model and import ASSET_INPUTS[\"model\"]; only declared inputs are readable. Preserve the source model. Local Blender and a remote modeling connector are independent choices; never switch to a paid service implicitly. For a native Unity source project pass format fbx. The host delivers outputs into Assets/Generated/blender/<job>; import model.fbx through Unity asset tools and instantiate it in a saved scene. Verify scale, materials and camera capture; FBX material conversion may require explicit material setup. Keep the companion GLB for browser use. No glTF importer package is installed implicitly."
    }
  ],
  "panels": [
    {
      "id": "setup",
      "title": "Local Blender",
      "file": "panel.html",
      "placement": "settings"
    }
  ],
  "settings": [],
  "actions": [
    {
      "name": "status",
      "label": "Runtime and jobs"
    },
    {
      "name": "install",
      "label": "Download Blender 5.2.1",
      "confirmation": "Download the pinned Blender 5.2.1 runtime for this computer (up to 405 MB) into this plugin’s storage. Studio verifies its digest. Existing external Blender installations stay unchanged."
    },
    {
      "name": "cancel-install",
      "label": "Cancel download"
    }
  ],

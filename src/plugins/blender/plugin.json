  "nativeJobs": [
    {
      "id": "model",
      "runtime": "blender",
      "args": [
        "-b",
        "--factory-startup",
        "-noaudio",
        "--python-exit-code",
        "1",
        "--python",
        {
          "source": "package",
          "name": "wrapper.py"
        },
        "--",
        {
          "source": "input",
          "name": "script"
        },
        {
          "source": "output",
          "name": "model.glb"
        },
        {
          "source": "output",
          "name": "render.png"
        },
        {
          "source": "value",
          "name": "name"
        }
      ],
      "inputs": ["script"],
      "values": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "maxLength": 40
        }
      },
      "outputs": ["model.glb", "render.png", "render-front.png"],
      "timeoutMs": 120000,
      "maxOutputBytes": 64000,
      "maxAssetBytes": 104857600,
      "gpu": true
    },
    {
      "id": "transform",
      "runtime": "blender",
      "args": [
        "-b",
        "--factory-startup",
        "-noaudio",

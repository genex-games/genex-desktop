        },
        {
          "source": "value",
          "name": "name"
        },
        {
          "source": "input",
          "name": "model"
        }
      ],
      "inputs": ["script", "model"],
      "values": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "maxLength": 40
        }
      },
      "outputs": ["model.glb", "render.png", "render-front.png"],
      "timeoutMs": 120000,
      "maxOutputBytes": 64000,
      "maxAssetBytes": 104857600,
      "gpu": true
    },

{
  "about": "The genex facade's agent-facing vocabularies, held by native/genex-rust/crates/genex/tests/vocabulary.rs (RUNTIME_KEYS, InstallErrorCode, the gpu_pass registration code, the Level-2 calls, which call each [[wgsl]] kind feeds, and the frame calls temporal effects need: draw ids and camera cuts; the environment calls with the wire spellings of its kinds and of `HdriSun`; the local-light and emissive calls of RQ6) and read by tests/conformance/rust-template-docs.test.ts, which checks the template docs name each. Change both sides with this file. Its `meshlets` block is the renderer's `genex_meshlets` glTF extras schema (genex-render's meshlet.rs, the host's src/shared/render-quality.ts), held by vocabulary.rs and tests/conformance/genex-toml.test.ts.",
  "runtimeKeys": [
    "version",
    "contractVersion",
    "seed",
    "frame",
    "simulatedMs",
    "running",
    "fps",
    "held",
    "pointerLock",
    "hud",
    "camera",
    "error",
    "player",
    "volatile",
    "__render",
    "assets",
    "checksum"
  ],
  "installRefusals": [
    "duplicate-camera",
    "duplicate-player",
    "duplicate-probe",
    "reserved-probe",
    "duplicate-camera-name",
    "duplicate-eye",
    "duplicate-demo",
    "invalid-name",
    "duplicate-facet-state",
    "invalid-world-size"
  ],
  "registrationRefusals": ["gpu-pass-invalid"],
  "levelTwoCalls": [
    "gfx.material",
    "gfx.set_material_uniforms",
    "gfx.post_pass",
    "gfx.post_pass_with",
    "frame.custom",
    "frame.post_pass",
    "game.wgsl"
  ],
  "wgslKindCalls": { "material": "gfx.material", "post": "gfx.post_pass", "pass": "game.gpu_pass" },
  "temporalCalls": ["frame.id", "frame.end_id", "frame.camera_cut"],
  "environment": {
    "calls": ["frame.environment", "Environment::sky", "Environment::hdri", "HdriEnvironment::new", "SkyParams::default"],
    "kinds": ["color", "sky", "hdri"],
    "hdriSun": ["analytic", "off"]
  },
  "lights": {
    "calls": [
      "frame.point_light",
      "frame.spot_light",
      "frame.spot_light_with",
      "SpotLight::new",
      "Material::emissive",
      ".with_emissive",
      ".with_emissive_texture"
    ]
  },
  "instanceGroups": {
    "calls": [
      "InstanceGroup::cubes",
      "InstanceGroup::spheres",
      "InstanceGroup::models",
      "InstanceGroup::models_with",
      "group.update",
      "frame.group"
    ],
    "refusals": ["too-many-instances", "range-out-of-group"]
  },
  "terrain": {
    "calls": [
      "Terrain::from_fn",
      "Terrain::from_heights",
      "TerrainLayer::textured",
      "TerrainLayer::flat",
      ".with_layers",
      "TerrainTexel::blend",
      ".with_control",
      "frame.terrain",
      "terrain.height",
      "Grass::meadow",
      ".with_grass",
      "Scatter::new",
      "terrain.scatter"
    ],
    "refusals": ["terrain-heights-invalid", "terrain-layers-invalid", "terrain-control-invalid"]
  },
  "particles": {
    "calls": [
      "Particles::steam",
      "Particles::rain",
      "Particles::fountain",
      ".with_rate",
      ".with_soft",
      ".with_sorted",
      ".with_collision",
      ".with_flipbook",
      "frame.particles"
    ],
    "refusals": ["particles-count-invalid", "particles-flipbook-invalid"]
  },
  "meshlets": {
    "extrasKey": "genex_meshlets",
    "schemaVersion": 1,
    "maxVertices": 64,
    "maxTriangles": 124,
    "recordBytes": 48,
    "minTrianglesDefault": 2048,
    "extrasKeys": [
      "version",
      "max_vertices",
      "max_triangles",
      "meshlets",
      "vertices",
      "triangles"
    ],
    "faults": [
      "meshlets-unknown-version",
      "meshlets-over-limit",
      "meshlets-range-out-of-bounds",
      "meshlets-ranges-not-tiled",
      "meshlets-vertex-out-of-mesh",
      "meshlets-local-index-out-of-meshlet",
      "meshlets-triangles-differ"
    ]
  },
  "lods": {
    "extrasKey": "genex_lods",
    "schemaVersion": 1,
    "maxLevels": 4,
    "minTriangles": 512,
    "extrasKeys": ["version", "indices", "levels"],
    "levelKeys": ["first", "count", "error"],
    "faults": ["lods-unknown-version", "lods-over-limit", "lods-range-out-of-bounds", "lods-vertex-out-of-mesh", "lods-not-coarser"]
  }
}

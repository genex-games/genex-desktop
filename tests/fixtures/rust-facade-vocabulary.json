  "animation": { "calls": ["gfx.character", ".joint_count", ".skeleton", ".path", ".wire"], "refusals": ["animation-asset-invalid", "animation-graph-invalid"] },
  "stream": { "calls": ["Streaming::grid", ".sim_radius", ".hysteresis", ".prefetch", ".anchors", "game.streaming", "game.cell_content", "CellBuild::default", ".thing", "sim.stream.set_anchor", "sim.stream.clear_anchor", "sim.stream.entered", "sim.stream.left"], "refusals": ["stream-invalid", "stream-too-many-anchors", "stream-out-of-world", "stream-not-registered", "stream-hold-timeout"] },
  "nav": { "calls": ["frame.lines"], "refusals": ["nav-input-invalid", "nav-too-large", "nav-tile-invalid", "nav-config-invalid", "nav-link-invalid", "nav-cost-invalid"] },
  "assets": {

  "fragments": {
    "about": "What the build lane compiles in for the documented table followed by these [[wgsl]] rows: GENEX_RENDER_TOML (the host's renderTomlFragment) and GENEX_WGSL_TOML (wgslTomlFragment). genex's RenderConfig::from_toml and its [[wgsl]] reader read them back as the same settings and rows (tests/render_settings.rs).",
    "wgslRows": "\n[[wgsl]]\npath = \"shaders/glow.wgsl\"\nkind = \"material\"\n\n[[wgsl]]\npath = \"shaders/vignette.wgsl\"\nkind = \"post\"\napi = 1\n",
    "render": "[render]\nform_factors = [\"desktop\", \"mobile\"]\npreset = \"auto\"\n[render.look]\ntonemapper = \"agx\"\nexposure = \"auto\"\nmetering = \"center\"\nev_compensation = -0.5\nbloom_intensity = 0.04\n[render.class.mobile-mid]\npreset = \"low\"\nrender_scale = 0.67\nfps = 30\nbloom = false\nao = false\n[render.class.desktop-ultra]\ntaa = true\ncontact-shadows = true\n",
    "wgsl": "[[wgsl]]\npath = \"shaders/glow.wgsl\"\nkind = \"material\"\napi = 1\n[[wgsl]]\npath = \"shaders/vignette.wgsl\"\nkind = \"post\"\napi = 1\n"

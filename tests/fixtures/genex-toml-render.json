{
  "about": "genex.toml's [render] table, [[wgsl]] api and [web] budget: rows both parsers read, the host's src/substrate/genex-toml.ts (tests/conformance/genex-toml.test.ts) and genex's manifest.rs (native/genex-rust/crates/genex/tests/manifest.rs). Each text follows a valid [game] table; an accepted row parses, a hostile row is refused with its code on both sides. Change both sides with this file.",
  "game": "[game]\ntitle = \"Pond\"\n",
  "accepted": [
    {
      "name": "the documented table",
      "text": "[render]\nform_factors = [\"desktop\", \"mobile\"]\npreset = \"auto\"\n\n[render.look]\ntonemapper = \"agx\"\nexposure = \"auto\"\nmetering = \"center\"\nev_compensation = -0.5\nbloom_intensity = 0.04\n\n[render.class.mobile-mid]\npreset = \"low\"\nrender_scale = 0.67\nfps = 30\nbloom = false\nao = false\n\n[render.class.desktop-ultra]\ntaa = true\ncontact-shadows = true\n"
    },
    { "name": "an empty [render]", "text": "[render]\n" },
    { "name": "the sun's shadows on every preset", "text": "[render.shadows]\ndistance = 80\nblend_band = 0.1\n" },
    { "name": "the edges of the shadow ranges", "text": "[render.shadows]\ndistance = 10\nblend_band = 0\n\n[render]\npreset = \"high\"\n" },
    { "name": "a widest blend band and a longest distance", "text": "[render.shadows]\ndistance = 400\nblend_band = 0.5\n" },
    { "name": "a preset alone", "text": "[render]\npreset = \"medium\"\n" },
    { "name": "a sub-table before its table", "text": "[render.look]\ntonemapper = \"khronos-neutral\"\n\n[render]\npreset = \"high\"\n" },
    { "name": "a whole render scale and the edges of every range", "text": "[render.class.desktop-low]\nrender_scale = 1\nfps = 60\n\n[render.class.mobile-low]\nrender_scale = 0.5\n\n[render.look]\nev_compensation = 10\nbloom_intensity = 0\n" },
    { "name": "a WGSL source at api 1", "text": "[[wgsl]]\npath = \"shaders/a.wgsl\"\nkind = \"post\"\napi = 1\n" },
    { "name": "a WGSL source at api 2", "text": "[[wgsl]]\npath = \"shaders/b.wgsl\"\nkind = \"material\"\napi = 2\n" },
    { "name": "auto exposure's limits and speeds at the edges of their ranges", "text": "[render.look]\nexposure = \"auto\"\nev_min = -16\nev_max = 16\nadaptation_speed_up = 20\nadaptation_speed_down = 0.1\n" },
    { "name": "an auto exposure held at one EV", "text": "[render.look]\nev_min = 2.5\nev_max = 2.5\n" },
